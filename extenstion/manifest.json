{
  "manifest_version": 3,
  "name": "Randy The Otter",
  "version": "0.1.0",
  "description": "Your cute little job search companion.",

  "content_scripts": [
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": ["src/content/bubble.js", "src/content/content.js"],
      "css": ["src/content/bubble.css", "src/content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Randy"
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/idle-alert.gif",
        "src/assets/talk.gif",
        "src/assets/press-start-2p-latin.woff2"
      ],
      "matches": ["https://www.linkedin.com/*"]
    }
  ]
}