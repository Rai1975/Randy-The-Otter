{
  "manifest_version": 3,
  "name": "Randy The Otter",
  "version": "0.1.0",
  "description": "Your cute little job search companion.",

  "permissions": ["downloads", "alarms", "storage"],

  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "http://localhost:5000/*"
  ],

  "background": {
    "service_worker": "src/background/background.js"
  },

  "content_scripts": [
    {
      "matches": ["https://joinhandshake.com/*", "https://*.joinhandshake.com/*"],
      "js": ["src/scrapers/handshake-interceptor.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://joinhandshake.com/*", "https://*.joinhandshake.com/*"],
      "js": ["src/content/handshake-bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.linkedin.com/*",
        "https://joinhandshake.com/*",
        "https://*.joinhandshake.com/*"
      ],
      "js": [
        "src/api/randy-session.js",
        "src/api/randy-backend.js",
        "src/content/bubble.js",
        "src/content/menu.js",
        "src/scrapers/linkedin-scraper.js",
        "src/scrapers/handshake-scraper.js",
        "src/scrapers/scraper.js",
        "src/content/content.js"
      ],
      "css": ["src/content/bubble.css", "src/content/menu.css", "src/content/content.css"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://job-boards.greenhouse.io/*", "*://boards.greenhouse.io/*"],
      "all_frames": true,
      "js": [
        "src/api/randy-session.js",
        "src/api/randy-backend.js",
        "src/content/bubble.js",
        "src/content/menu.js",
        "src/scrapers/greenhouse-autofill.js",
        "src/content/content.js"
      ],
      "css": ["src/content/bubble.css", "src/content/menu.css", "src/content/content.css"],
      "run_at": "document_idle"
    }
  ],

  "action": {
    "default_title": "Randy"
  },

  "options_ui": {
    "page": "src/settings/options.html",
    "open_in_tab": true
  },

  "web_accessible_resources": [
    {
      "resources": [
        "src/assets/idle-alert.gif",
        "src/assets/talk.gif",
        "src/assets/roast.gif",
        "src/assets/roast-talk.gif",
        "src/assets/press-start-2p-latin.woff2"
      ],
      "matches": [
        "https://www.linkedin.com/*",
        "https://joinhandshake.com/*",
        "https://*.joinhandshake.com/*",
        "*://job-boards.greenhouse.io/*",
        "*://boards.greenhouse.io/*"
      ]
    }
  ]
}
