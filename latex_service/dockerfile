FROM python:3.12-slim

ARG TECTONIC_VERSION=0.15.0

RUN apt-get update && \
    apt-get install -y \
        curl \
        ca-certificates \
        tar \
        gzip \
        libfontconfig1 \
        libharfbuzz0b \
        libgraphite2-3 \
        libssl3 \
        && \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    url="https://github.com/tectonic-typesetting/tectonic/releases/download/tectonic%40${TECTONIC_VERSION}/tectonic-${TECTONIC_VERSION}-x86_64-unknown-linux-gnu.tar.gz"; \
    curl -fsSL "$url" -o /tmp/tectonic.tar.gz; \
    tar -xzf /tmp/tectonic.tar.gz -C /tmp; \
    find /tmp -type f -name tectonic -exec mv {} /usr/local/bin/tectonic \;; \
    chmod +x /usr/local/bin/tectonic; \
    rm -rf /tmp/tectonic.tar.gz /tmp/tectonic; \
    tectonic --version

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY main.py .

CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]